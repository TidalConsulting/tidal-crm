{
  "name": "tidal-os",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @tidal/web dev",
    "build": "pnpm --filter @tidal/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @tidal/core test",
    "db:generate": "pnpm --filter @tidal/db generate",
    "db:migrate": "pnpm --filter @tidal/db migrate",
    "db:seed": "pnpm --filter @tidal/core seed",
    "db:reset": "pnpm --filter @tidal/core reset"
  }
}

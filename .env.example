# Owner connection. The app drops to the app_user role per request, so RLS applies.
DATABASE_URL=postgres://tidal:tidal@localhost:5432/tidal
TEST_DATABASE_URL=postgres://tidal:tidal@localhost:5432/tidal_test

# "dev" = pick a seeded user on /login (local only). "supabase" = Google SSO via Supabase Auth.
AUTH_MODE=dev
# Signs the dev-mode session cookie. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Supabase mode only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated Google Workspace domains allowed to sign in
ALLOWED_EMAIL_DOMAINS=tidalconsulting.com
